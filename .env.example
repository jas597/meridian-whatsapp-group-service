PORT=3000
ALLOWED_GROUP_NAME=Meridian Staff
WHATSAPP_WEBHOOK_SECRET=replace-with-a-long-random-secret
WHATSAPP_SESSION_PATH=/var/data/whatsapp-session
QR_PAGE_SECRET=replace-with-another-long-random-secret
NODE_ENV=production

# Dedicated floor-plan service only. Use a new Render service and disk.
WHATSAPP_CLIENT_ID=meridian-floor-plan
WHATSAPP_EXPECTED_SENDER=13362186470
EMAIL_RECEIPTS_PATH=/var/data/email-receipts
GMAIL_USER=info@meridianconvention.com
# Add securely in Render after deployment; never commit a real password.
GMAIL_APP_PASSWORD=

# WhatsApp Cloud API (official Meta Business Platform) - replaces the
# whatsapp-web.js/Puppeteer gateway above once fully migrated.
# System User permanent access token from Meta Business Settings > System users.
WHATSAPP_CLOUD_API_TOKEN=replace-with-a-meta-system-user-access-token
# Arbitrary string you choose yourself (not issued by Meta) - enter the same
# value when configuring the webhook Callback URL in the Meta app dashboard.
WHATSAPP_CLOUD_API_VERIFY_TOKEN=replace-with-a-long-random-string
# Default Phone Number ID (from WhatsApp Manager > Phone numbers) used when a
# send request doesn't specify one.
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=replace-with-default-phone-number-id
# Phone Number ID used when a send request sets from: "kim".
WHATSAPP_CLOUD_API_KIM_PHONE_NUMBER_ID=replace-with-kims-phone-number-id
# Optional, defaults to v21.0.
WHATSAPP_CLOUD_API_VERSION=v21.0
